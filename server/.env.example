# Local MongoDB (default) or a MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/careslot
JWT_SECRET=change-this-to-a-long-random-string
PORT=5000
# Production password reset email (Resend HTTP API; use a verified sender domain)
RESEND_API_KEY=
RESEND_FROM=
# Public URL of the frontend, used to create password reset links
APP_URL=
# Optional SMTP fallback when RESEND_API_KEY is not set
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional: enables AI-written cancellation-reason suggestions (built-in suggestions are used if unset)
ANTHROPIC_API_KEY=
